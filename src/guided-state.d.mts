export type GuidedEventType='attempt'|'recall'|'complete'|'note';
export type GuidedEvent={eventId:string;deviceId:string;knowledgeId:string;occurredAt:string;type:GuidedEventType;payload:Record<string,any>};
export type GuidedDraft={draftId:string;deviceId:string;knowledgeId:string;updatedAt:string;values:Record<string,any>};
export type GuidedConflict={kind:'event'|'draft';id:string;existing:GuidedEvent|GuidedDraft;incoming:GuidedEvent|GuidedDraft};
export type GuidedQuarantine={kind:'event'|'draft';reason:string;entry:GuidedEvent|GuidedDraft};
export type GuidedState={schemaVersion:1;revision:number;events:GuidedEvent[];drafts:GuidedDraft[];quarantine:GuidedQuarantine[];conflicts:GuidedConflict[]};
export type GuidedTransfer={schemaVersion:1;deviceId?:string;exportedAt?:string;events:GuidedEvent[];drafts?:GuidedDraft[];quarantine?:GuidedQuarantine[];conflicts?:GuidedConflict[]};
export type GuidedMergeSummary={addedEvents:number;addedDrafts:number;duplicates:number;conflicts:number;quarantined:number;promoted:number};
export type GuidedMergeResult={state:GuidedState;summary:GuidedMergeSummary};
export type GuidedProgress={knowledgeId:string;attempts:number;correctAttempts:number;variantAttempts:number;variantCorrect:number;independentRecallCount:number;independentRecallDays:string[];completionCount:number;failedRecallStreak:number;reviewStage:number;nextReview:string;lastAt:string;lastRating:string;lastCompleteAt:string;reasonCounts:Record<string,number>;lastNote:Record<string,any>|null;due:boolean};
export const GUIDED_SCHEMA_VERSION:1;
export const guidedReasonLabels:Record<string,string>;
export function emptyGuidedState():GuidedState;
export function validateGuidedEvent(event:unknown):GuidedEvent;
export function validateGuidedDraft(draft:unknown):GuidedDraft;
export function mergeGuidedState(state:GuidedState,bundle:GuidedTransfer,knownIds:Iterable<string>):GuidedMergeResult;
export function createGuidedEvent(knowledgeId:string,type:GuidedEventType,payload:Record<string,any>,deviceId:string,at?:string):GuidedEvent;
export function createTransferBundle(state:GuidedState,deviceId:string,at?:string):GuidedTransfer;
export function summarizeGuided(state:GuidedState,at?:Date|string):Record<string,GuidedProgress>;
export function selectGuidedQueue<T extends {id:string}>(lessons:T[],state:GuidedState,at?:Date|string):{due:T[];learn:T[];items:Record<string,GuidedProgress>;minutes:number};
