export function roundedRatio(n:number|bigint,d:number|bigint,places?:number):string;
export function normalizeMathInput(value:unknown):string;
export function gradeMathAnswer(question:MathQuestion,value:unknown):{valid:boolean;correct:boolean;message:string};
export function makeMathQuestion(category:string,params:Record<string,any>):MathQuestion;
export function buildMathRound(options?:{categories?:string[];size?:number;seed?:number;level?:string;previousKeys?:string[];reviewQuestions?:MathQuestion[]}):MathQuestion[];
